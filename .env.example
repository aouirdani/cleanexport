# Copy to .env and fill in real values. Nothing in this file is a secret.

# --- Database (required) -----------------------------------------------
# `sslmode=verify-full` is explicit on purpose. Neon (and most managed
# Postgres) requires TLS; `pg` (via pg-connection-string) already upgrades
# `sslmode=require`/`prefer`/`verify-ca` to full certificate verification
# today, but warns on every connection that this is deprecated behaviour:
#   "SECURITY WARNING: The SSL modes 'prefer', 'require', and 'verify-ca'
#   are treated as aliases for 'verify-full' ... In the next major version
#   ... these modes will adopt standard libpq semantics, which have weaker
#   security guarantees."
# Writing `verify-full` here states the behaviour we already rely on
# instead of leaving it to an alias that a future pg major version will
# quietly weaken. Do not change this to `require`, `prefer`, or
# `uselibpqcompat=true&sslmode=require` - those are the weaker modes the
# warning is about.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=verify-full"

# --- Session / crypto (required) ----------------------------------------
# 32-byte keys, base64 or hex - see lib/crypto.ts and lib/session.ts for
# the exact format each one expects.
ENCRYPTION_KEY=
SESSION_SECRET=

# --- HubSpot OAuth (required) --------------------------------------------
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:3000/api/auth/hubspot/callback
HUBSPOT_SCOPES="oauth crm.objects.contacts.read crm.objects.companies.read crm.objects.deals.read crm.objects.tickets.read"
# Pinned per recon/FINDINGS.md #1 - date-based versioning is live and
# preferred over v3. Optional: defaults to 2026-03 (lib/hubspot/client.ts).
HUBSPOT_API_VERSION=2026-03

# --- Stripe billing (required) -------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=

# --- Email delivery (required) --------------------------------------------
RESEND_API_KEY=
# Optional: defaults to 'CleanExport <exports@cleanexport.app>' (inngest/email.ts).
EMAIL_FROM="CleanExport <exports@cleanexport.app>"

# --- Object storage for generated .xlsx files (required) ------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Signs download URLs - see inngest/r2.ts. A separate secret from
# ENCRYPTION_KEY/SESSION_SECRET; do not reuse either for this.
R2_OBJECT_KEY_SECRET=

# --- Optional --------------------------------------------------------------
# Absolute base URL used to build links in emails (inngest/email.ts) and
# Stripe redirect URLs (lib/stripe.ts). Defaults to http://localhost:3000.
APP_URL=http://localhost:3000
# error/warn/info/debug. Defaults to 'info' (lib/logger.ts).
LOG_LEVEL=info
# Sentry - unset means Sentry is a no-op locally.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
