{
  "uid": "cleanexport_app",
  "type": "app",
  "config": {
    "description": "Scheduled, correctly formatted Excel exports of your HubSpot CRM data.",
    "name": "CleanExport",
    "distribution": "marketplace",
    "auth": {
      "type": "oauth",
      "redirectUrls": [
        "http://localhost:3000/api/auth/hubspot/callback",
        "http://localhost:3000/api/auth/hubspot/callback",
        "https://cleanexport.vercel.app/api/auth/hubspot/callback"
      ],

      "requiredScopes": [
        "oauth",
        "crm.objects.contacts.read",
        "crm.objects.companies.read",
        "crm.objects.deals.read",
        "crm.objects.owners.read",
        "tickets",
        "crm.schemas.contacts.read",
        "crm.schemas.companies.read",
        "crm.schemas.deals.read"
      ],
      "optionalScopes": [],
      "conditionallyRequiredScopes": []
    },
    "permittedUrls": {
      "fetch": ["https://api.hubapi.com"],
      "iframe": [],
      "img": []
    },
    "support": {
      "supportEmail": "aymane.ouirdani94@icloud.com",
      "documentationUrl": "https://example.com/docs",
      "supportUrl": "https://example.com/support"
    }
  }
}
